{{

  "buildCommand": "npm install --legacy-peer-deps && npm run build",  "version": 2,

  "devCommand": "npm start",  "builds": [

  "installCommand": "npm install --legacy-peer-deps",    {

  "framework": null,      "src": "package.json",

  "outputDirectory": "build"      "use": "@vercel/static-build",

}      "config": {

        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
